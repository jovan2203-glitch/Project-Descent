[resource]
script = ExtResource("1_s")
id = &"whirl"
display_name = "Whirl"
description = "Spin with both blades: {hit} Physical damage to every enemy within {a:whirl.radius} m, ripping out your stuck daggers in each. With no enemy that close, Knife Spread instead: a dagger into each of up to {b:KNIFE_SPREAD_TARGETS} enemies in front of you, {d:KNIFE_SPREAD_COEF} Physical damage each, and they stick. Builds Flow for each enemy hit, up to {b:WHIRL_FLOW_MAX}. In a Kill window it becomes {n:redwhirl}."
tags = PackedStringArray("Ability", "Physical", "Melee", "Ranged", "AoE")
cast_type = 0
cast_time = 0.0
requires_target = false
weapon_requirement = 1
requires_dual_wield = true
resource_type = 2
damage = 0.0
damage_type = &"physical"
