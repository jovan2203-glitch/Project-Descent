[resource]
script = ExtResource("1_s")
id = &"raisethecenser"
display_name = "Raise the Censer"
description = "Your censer rises {b:RAISE_CENSER_HEIGHT} m over an enemy up to {range} m away and hangs there for {b:RAISE_CENSER_TIME} sec. Enemies within {radius} m of it are forced to attack you for {b:RAISE_CENSER_TAUNT} sec, and it sheds a mote of light around itself {bev:RAISE_CENSER_SHED_EVERY}. While it is away, your Incense gives no Block and no aura."
tags = PackedStringArray("Ability", "Holy", "Taunt", "Defensive")
cast_type = 0
cast_time = 0.0
requires_target = true
requires_off_hand = true
weapon_requirement = 1
resource_type = 1
damage = 0.0
damage_type = &"holy"
