display_name = "Interval Ward"
description = "Shields you for {heal} damage for {b:INTERVAL_WARD_TIME} sec. While the shield holds, the cooldowns of your Arcane spells recover {b:INTERVAL_WARD_RATE_PCT}% faster (interrupts are not affected). If the shield is broken early, the time it had left is taken off this spell's cooldown."
