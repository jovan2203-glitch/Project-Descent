[gd_resource type="Resource" script_class="AbilityData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = &"puppetstring"
display_name = "String"
description = "Ties a String to your friendly target, or to you if you have none. It heals for {ds:STRING_HEAL} {bev:STRING_TICK} for {string_time} sec. Up to {b:STRING_STACKS} go on one ally, and another one starts the time of all of them over. On an enemy target, the String lasts {b:STRING_ENEMY_TIME} sec and is crossed with the ally you tied last. Each use takes one String from your hand, and only {b%:STRING_GCD_MULT}% of a global cooldown."
tags = PackedStringArray("Shadow", "Spell")
cast_type = 0
cast_time = 0.0
cooldown = 0.0
requires_target = false
weapon_requirement = 0
resource_type = 0
resource_cost = 0
resource_generated = 0
damage = 0.0
weapon_damage_multiplier = 0.0
cast_range = 40.0
radius = 0.0
damage_type = &"shadow"
threat_multiplier = 1.0
