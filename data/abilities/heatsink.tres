[resource]
script = ExtResource("1_s")
id = &"heatsink"
display_name = "Heat Sink"
description = "For {b:HEAT_SINK_TIME} sec you take {b:HEAT_SINK_PCT}% less damage, and what you were spared is stored as heat. When it ends the heat bursts out, dealing {hit} Fire damage to all enemies within {radius} m, growing to as much as {heat_sink_max} the more you stored (the most once {b:HEAT_SINK_FULL_AT}% of your health is stored)."
tags = PackedStringArray("Fire", "Spell", "AoE")
