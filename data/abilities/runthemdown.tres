script = ExtResource("1_s")
id = &"runthemdown"
display_name = "Run Them Down"
description = "Strikes all enemies within {radius} m for {hit} Shadow damage. For {b:RUN_DOWN_TIME} sec each bite of your Hounds also hits up to {run_down_targets} other enemies within {b:RUN_DOWN_REACH} m of the one bitten, for {b:RUN_DOWN_PCT}% of its damage. Rouses your Hounds. The strike deals full damage to up to {b:AOE_TARGET_CAP} enemies; with more, that damage is split evenly between all of them."
