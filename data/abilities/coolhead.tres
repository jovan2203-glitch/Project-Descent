[resource]
script = ExtResource("1_s")
id = &"coolhead"
display_name = "Cool Head"
description = "For {b:COOL_HEAD_TIME} sec your Fire spells and abilities cannot critically strike, and each one that deals damage grants a stack of Concentrated Fire. When {n:coolhead} ends, your next Fire spells and abilities with a cast time are instant, one cast per stack, for {b:CONCENTRATED_FIRE_WINDOW} sec."
