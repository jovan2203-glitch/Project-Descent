[resource]
script = ExtResource("1_s")
id = &"coolingslag"
display_name = "Cooling Slag"
description = "Pours molten slag on the ground within {radius} m of the target. Enemies in it move {b:COOLING_SLAG_SLOW}% slower. After {b:COOLING_SLAG_HARDEN} sec the slag hardens, rooting every enemy still inside for {b:COOLING_SLAG_ROOT} sec."
tags = PackedStringArray("Fire", "Spell", "Utility", "Root")
