script = ExtResource("1_s")
id = &"stillstanding"
display_name = "Still Standing"
description = "For {b:STILL_STANDING_TIME} sec, a killing blow leaves an ally on one of your Strings at a sliver of health instead. The Strings then hold it up for {b:STILL_STANDING_HOLD} sec, and nothing can kill it. If it is below {b:STILL_STANDING_HEALTH_PCT}% health when that ends, it falls."
