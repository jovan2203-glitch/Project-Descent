[resource]
script = ExtResource("1_s")
id = &"pourout"
display_name = "Pour Out"
description = "Pours all the light out of your censer in one wave, dealing Holy damage for each Incense spent ({pour_full} with a full censer), with {threat}x threat, to all enemies within {radius} m. Needs at least {b:POUR_OUT_MIN} Incense. Drops motes of light worth {pour_motes}% of what it spent. Full damage to up to {b:AOE_TARGET_CAP} enemies; with more, that damage is split evenly between all of them."
tags = PackedStringArray("Ability", "Holy", "AoE")
cast_type = 0
cast_time = 0.0
requires_target = false
requires_off_hand = true
weapon_requirement = 1
resource_type = 1
damage = 0.0
damage_type = &"holy"
