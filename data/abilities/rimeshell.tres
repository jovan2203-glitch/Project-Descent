[ext_resource type="Resource" path="res://data/effects/weakened_soul.tres" id="2_fx"]

[resource]
script = ExtResource("1_s")
id = &"rimeshell"
display_name = "Rime Shell"
description = "Encases the target in a Rime Shell for {e:rime_shell.time} sec that absorbs {heal} damage. On an ally, they also take {e:rime_shell.pct}% less damage and receive {ne:weakened_soul}. On an enemy, it takes {e:rime_shell_foe.pct}% more damage of every kind from everyone. Targets you if you have no target. When the shell breaks, it shatters for {hit} Frost damage to all enemies within {radius} m. Allies are not harmed. A shatter that damages only one enemy deals {b:RIME_SHELL_SOLO_PCT}% more. On an enemy the shell stays for its full duration after it shatters."
tags = PackedStringArray("Frost", "Spell", "Shield")
cast_type = 1
cast_time = 2.0
requires_target = false
resource_type = 1
resource_cost = 2
damage = 1.0
cast_range = 40.0
radius = 5.0
ally_lockout_effect = ExtResource("2_fx")
damage_type = &"frost"
