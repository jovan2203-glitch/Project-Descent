[resource]
script = ExtResource("1_s")
id = &"rootguard"
display_name = "Rootguard"
description = "Roots grow up around an ally and shield them for {heal}, plus {rootguard_per} for each Blossom on them, for {b:ROOTGUARD_TIME} sec. Uses up their Blossoms. If the shield is used up, every ally within {b:ROOTGUARD_SPREAD} m of them gains a Blossom."
tags = PackedStringArray("Nature", "Spell", "Defensive")
cast_type = 0
cast_time = 0.0
requires_target = false
weapon_requirement = 0
resource_type = 1
damage = 0.0
damage_type = &"nature"
