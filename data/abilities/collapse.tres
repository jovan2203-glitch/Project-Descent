[resource]
script = ExtResource("1_s")
id = &"collapse"
display_name = "Collapse"
description = "Opens a rift over an area {width} m wide. After {b:COLLAPSE_DELAY} sec it implodes, dealing {hit} Arcane damage to all enemies inside and pulling them up to {collapse_pull} m toward its centre. Full damage to up to {b:AOE_TARGET_CAP} enemies; with more, that damage is split evenly between all of them."
