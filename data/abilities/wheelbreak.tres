script = ExtResource("1_s")
id = &"wheelbreak"
display_name = "Finisher"
description = "A place on your bar for the finisher of the weapon you hold: {n:shrapnel}, {n:shardlance}, {n:flyinghead} or {n:faultline}. It becomes that move. Finishers break the weapon, deal more for every Crack in it, and bring the next weapon on your Wheel into your hands."
