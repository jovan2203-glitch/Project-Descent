[resource]
script = ExtResource("1_s")
id = &"flyinghead"
display_name = "Flying Head"
description = "The Halberd's head snaps off and flies into the target, dealing {hit} Physical damage plus {d:BREAK_PER_CRACK} for each Crack in it, then bounces to up to {b:FLYING_HEAD_BOUNCES} more enemies, each within {b:FLYING_HEAD_REACH} m of the last, for {b:FLYING_HEAD_BOUNCE_PCT}% of that. The next weapon on your Wheel comes into your hands."
tags = PackedStringArray("Ability", "Physical", "Melee", "AoE")
cast_type = 0
cast_time = 0.0
requires_target = true
weapon_requirement = 1
resource_type = 3
damage = 0.0
damage_type = &"physical"
