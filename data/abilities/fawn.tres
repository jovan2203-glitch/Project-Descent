[resource]
script = ExtResource("1_s")
id = &"fawn"
display_name = "Fawn"
description = "Weaves a fawn that heals an ally for {heal}, then bounces up to {b:FAWN_BOUNCES} times, each time to the lowest-health ally within {b:FAWN_REACH} m it has not healed yet, healing {fawn_less}% less each bounce. Leaves a Blossom on every ally it heals, two if the heal is more than they were missing."
tags = PackedStringArray("Nature", "Spell", "Heal")
cast_type = 1
cast_time = 0.0
requires_target = false
weapon_requirement = 0
resource_type = 1
damage = 0.0
damage_type = &"nature"
