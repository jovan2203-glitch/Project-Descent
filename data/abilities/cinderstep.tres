[resource]
script = ExtResource("1_s")
id = &"cinderstep"
display_name = "Cinder Step"
description = "Dash up to {b:CINDER_STEP_DISTANCE} m forward, leaving a line of cinders for {b:CINDER_STEP_LINE_TIME} sec that deals {hit} Fire damage every {b:CINDER_STEP_TICK} sec to enemies standing in it. Your next Fire spell with a cast time, within {b:CINDER_STEP_BUFF_TIME} sec, can be cast while moving."
tags = PackedStringArray("Fire", "Spell", "Movement")
