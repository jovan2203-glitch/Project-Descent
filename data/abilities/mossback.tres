[gd_resource type="Resource" script_class="AbilityData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = &"mossback"
display_name = "Mossback"
description = "An old bear grows out of your Mulch and mauls your target for {hit} Nature damage, plus {ds:MOSSBACK_PER_PATCH} for each patch it uses up. Place its circle on the patches to use; with mouseover casting, it uses the patches within {b:MULCH_REACH} m of the enemy under your mouse. With your {mulch_now} patches: {mossback_now}. With {b:MULCH_MAX}: {mossback_full}."
tags = PackedStringArray("Nature", "Spell")
cast_type = 0
cast_time = 0.0
requires_target = true
weapon_requirement = 0
resource_type = 1
damage = 0.0
damage_type = &"nature"
