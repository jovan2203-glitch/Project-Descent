[resource]
script = ExtResource("1_s")
id = &"heavydraw"
display_name = "Heavy Draw"
description = "Draw all the way back and shoot your target for {hit} Physical damage. When it hits, {n:quickshot} is ready again at once and every other shot of yours comes back {heavy_cut} sec sooner (a critical hit: all of them at once). At {b:STREAK_MAX} Streak it is instant and always a critical hit. Builds Streak and spends its Overcut."
tags = PackedStringArray("Ability", "Physical", "Ranged", "Projectile")
cast_type = 1
cast_time = 1.5
requires_target = true
weapon_requirement = 2
resource_type = 0
damage = 0.0
damage_type = &"physical"
