script = ExtResource("1_s")
id = &"circleofsilence"
display_name = "Circle of Silence"
description = "A circle of silence settles on the ground within {radius} m of the target for {b:CIRCLE_OF_SILENCE_TIME} sec. Every enemy casting inside it is interrupted, and any enemy that starts a cast inside it while it lasts is interrupted too. Each is prevented from casting again for {lockout} sec."
