[resource]
script = ExtResource("1_s")
id = &"venomburst"
display_name = "Venom Burst"
description = "Costs {b:VENOM_BURST_COST} Venom. The target explodes, taking all the damage your poisons on it have left, {b:BURST_PER_POISON}% more for each different poison, and they are removed. Enemies within {b:BURST_RADIUS} m take {b:BURST_SPLASH_PCT}% of it; full damage to up to {b:AOE_TARGET_CAP} enemies, with more it is split evenly between them. On a Steeped target you get {b:BURST_STEEPED_REFUND} Venom back."
tags = PackedStringArray("Ability", "Nature", "Ranged", "Projectile", "AoE")
cast_type = 0
cast_time = 0.0
requires_target = true
weapon_requirement = 2
resource_type = 0
resource_cost = 0
damage = 0.0
damage_type = &"nature"
