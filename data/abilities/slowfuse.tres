[resource]
script = ExtResource("1_s")
id = &"slowfuse"
display_name = "Slow Fuse"
description = "Plants a charge on the target that explodes after {b:SLOW_FUSE_TIME} sec for {hit} Fire damage. Each of your hits on that target that does not critically strike makes the explosion bigger (damage over time does not count). Planting it again on the same target sets the old charge off at once."
