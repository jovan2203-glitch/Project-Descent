[gd_resource type="Resource" script_class="RuneData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/rune_data.gd" id="1_s"]

[resource]
script = ExtResource("1_s")
id = &"overload"
display_name = "Rune of Overload"
description = "Your Lightning spells and abilities build Static, up to {b:STATIC_MAX_STACKS}. You deal {b:STATIC_DAMAGE_PCT}% more Lightning damage per Static, and all of it is lost after {b:STATIC_TIME} sec without gaining more. If building Static leaves you at {b:STATIC_MAX_STACKS}, you Overload: all of it discharges for {amount} Lightning damage per Static to enemies within {radius} m, and you cannot build Static for {b:OVERLOAD_LOCKOUT} sec. After {b:OVERLOAD_GROUND_AFTER} sec without casting a Lightning spell or ability you become Grounded: you cannot Overload, and it lasts {b:OVERLOAD_GROUND_TIME} sec once you cast Lightning again."
color = Color(0.45, 0.55, 1, 1)
rarity = 2
unlock_level = 10
trigger = 6
effect_amount = 0.1
damage_type = &"lightning"
effect_tags = PackedStringArray("Lightning", "Spell", "AoE")
radius = 6.0
